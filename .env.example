# =============================================================================
# Sinopebase — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Runtime mode ---
# Set SINOPEBASE_PRODUCTION=true for fail-closed production behavior:
#   - Rejects known default/test JWT secrets
#   - Refuses memory/local fallbacks when POSTGRES_URL is set
#   - Enforces credential validation at boot
# SINOPEBASE_PRODUCTION=true

# --- Server ---
# PORT=8090
# HOST=0.0.0.0

# --- Database (PostgreSQL) ---
# Required for production. Leave empty for in-memory dev mode.
# POSTGRES_URL=postgresql://sinopebase:sinopebase@localhost:5432/sinopebase

# --- Storage (S3-compatible) ---
# Required for production. Leave empty for local filesystem in dev mode.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=sinopebase-storage
# S3_REGION=us-east-1

# --- Auth / JWT (REQUIRED — generate unique values for production) ---
# Generate: openssl rand -hex 32
# DO NOT use these placeholder values in production:
#   sinopebase-dev-jwt-secret-min-32-chars!!
#   test-service-role-key-min-32-chars!!
#   test-anon-key-min-32-characters!!!
# The server will REFUSE to start in production mode with these defaults.
JWT_SECRET=sinopebase-dev-jwt-secret-min-32-chars!!
SINOPEBASE_SERVICE_ROLE_KEY=test-service-role-key-min-32-chars!!
SINOPEBASE_ANON_KEY=test-anon-key-min-32-characters!!!

# --- OAuth / SSO (optional) ---
# Configure OAuth providers for social login. See docs/auth.md for details.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- AI / Mastra (optional) ---
# Set to enable Mastra agent endpoints. Without this, the mock provider echoes back.
# OPENAI_API_KEY=sk-...

# --- Security hardening ---
# For production, set these to cryptographically random values (≥32 chars)
# and enable SINOPEBASE_PRODUCTION=true.
