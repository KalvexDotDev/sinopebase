# One-shot private ACA job image. It contains no HTTP server or listener.
FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS builder
WORKDIR /build
COPY . .
RUN bun install --frozen-lockfile
RUN bun build cmd/staging-bootstrap.ts --compile --minify --outfile /out/staging-bootstrap --target bun

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk upgrade --no-cache libcrypto3 libssl3 \
 && addgroup -S -g 10001 bootstrap \
 && adduser -S -D -H -u 10001 -G bootstrap bootstrap
COPY --from=builder --chown=bootstrap:bootstrap /out/staging-bootstrap /app/staging-bootstrap
COPY --from=builder /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1
COPY --from=builder /usr/lib/libstdc++.so.6.0.33 /usr/lib/libstdc++.so.6.0.33
COPY --from=builder /usr/lib/libstdc++.so.6 /usr/lib/libstdc++.so.6
USER 10001:10001
ENTRYPOINT ["/app/staging-bootstrap"]
