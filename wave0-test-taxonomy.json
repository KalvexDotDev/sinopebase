{
  "schemaVersion": 1,
  "testRunIdEnvironment": "SINOPEBASE_TEST_RUN_ID",
  "suites": [
    {
      "id": "unit",
      "kind": "unit",
      "releaseRequired": true,
      "include": [
        "cmd/**/*.test.ts",
        "core/**/*.test.ts",
        "daos/**/*.test.ts",
        "forms/**/*.test.ts",
        "mails/**/*.test.ts",
        "migrations/**/*.test.ts",
        "models/**/*.test.ts",
        "plugins/**/*.test.ts",
        "tools/**/*.test.ts",
        "ui/**/*.test.ts",
        "src/**/*.test.ts",
        "tests/tools/**/*.test.ts",
        "tests/apis/**/*.test.ts",
        "tests/harness/**/*.test.ts",
        "tests/core/**/*.test.ts"
      ],
      "exclude": [
        "src/core/db-postgres-contract.test.ts",
        "src/core/db-postgres-rls.test.ts"
      ],
      "infrastructure": [],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "shared",
        "port": "none",
        "namespace": "per-test",
        "filesystem": "temp-per-test"
      }
    },
    {
      "id": "component",
      "kind": "component",
      "releaseRequired": true,
      "include": [
        "tests/integration/app-lifecycle.test.ts",
        "tests/integration/pb-api-*.test.ts"
      ],
      "infrastructure": [],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    },
    {
      "id": "auth-contract",
      "kind": "contract",
      "releaseRequired": true,
      "include": [
        "tests/integration/auth.test.ts",
        "tests/integration/auth-better.test.ts"
      ],
      "infrastructure": [
        "TEST_POSTGRES_URL",
        "SINOPEBASE_ANON_KEY",
        "SINOPEBASE_SERVICE_ROLE_KEY"
      ],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    },
    {
      "id": "postgrest-contract",
      "kind": "contract",
      "releaseRequired": true,
      "include": ["tests/integration/postgrest.test.ts"],
      "infrastructure": [
        "TEST_POSTGRES_URL",
        "SINOPEBASE_ANON_KEY",
        "SINOPEBASE_SERVICE_ROLE_KEY"
      ],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    },
    {
      "id": "storage-contract",
      "kind": "contract",
      "releaseRequired": true,
      "include": ["tests/integration/storage.test.ts"],
      "infrastructure": [
        "TEST_POSTGRES_URL",
        "SINOPEBASE_ANON_KEY",
        "SINOPEBASE_SERVICE_ROLE_KEY",
        "RUSTFS_ENDPOINT",
        "RUSTFS_ACCESS_KEY",
        "RUSTFS_SECRET_KEY"
      ],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    },
    {
      "id": "realtime-contract",
      "kind": "contract",
      "releaseRequired": true,
      "include": ["tests/integration/realtime.test.ts"],
      "infrastructure": [
        "TEST_POSTGRES_URL",
        "SINOPEBASE_ANON_KEY",
        "SINOPEBASE_SERVICE_ROLE_KEY"
      ],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    },
    {
      "id": "postgres-rls-contract",
      "kind": "contract",
      "releaseRequired": true,
      "include": [
        "src/core/db-postgres-contract.test.ts",
        "src/core/db-postgres-rls.test.ts"
      ],
      "infrastructure": [
        "TEST_POSTGRES_URL",
        "SINOPEBASE_ANON_KEY",
        "SINOPEBASE_SERVICE_ROLE_KEY"
      ],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    },
    {
      "id": "plugin-integration",
      "kind": "integration",
      "releaseRequired": true,
      "include": ["tests/plugins/**/*.test.ts"],
      "infrastructure": ["TEST_POSTGRES_URL"],
      "onMissingInfrastructure": "fail",
      "fallbackPolicy": "forbid",
      "isolation": {
        "process": "per-file",
        "port": "dynamic",
        "namespace": "per-suite",
        "filesystem": "temp-per-suite"
      }
    }
  ]
}
