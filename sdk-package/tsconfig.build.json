{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The SDK uses web APIs (Blob, FormData, fetch) — DOM lib required here.
    "lib": ["ESNext", "DOM"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
