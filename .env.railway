# =============================================================================
# Sinopebase -- Railway Deployment Environment Variables
# =============================================================================
# Copy this file to your Railway service dashboard as environment variables.
# Never commit real secrets to version control.
#
# How to use:
#   1. Go to Railway Dashboard > your-project > your-service > Variables
#   2. Add each variable from this template
#   3. Set RAILWAY_TOKEN in GitHub Actions secrets (not here)
# =============================================================================

# --- Runtime ---
NODE_ENV=production
SINOPEBASE_PRODUCTION=true

# Railway injects PORT automatically. Override only if you need a different
# port than the default Railway assigns.
# PORT=8090
# HOST=0.0.0.0

# --- Database ---
# PostgreSQL connection string. Railway PostgreSQL plugins inject this
# automatically when attached. If using an external database, set manually:
POSTGRES_URL=postgresql://user:password@host:5432/sinopebase

# Optional read-replica for horizontal scaling
# READ_REPLICA_URL=postgresql://user:password@replica-host:5432/sinopebase

# --- Auth / JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Sinopebase service-role key (for admin operations)
SINOPEBASE_SERVICE_ROLE_KEY=

# Sinopebase anon key (for public / client-side operations)
SINOPEBASE_ANON_KEY=

# --- Storage (S3-compatible) ---
# Railway Volume mounts are available at /data for local file storage.
# For S3-compatible object storage (MinIO, R2, AWS S3):
# S3_ENDPOINT=https://your-storage-endpoint.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=sinopebase-storage

# --- AI / Mastra ---
# Required for AI features (Mastra agents etc.)
# OPENAI_API_KEY=sk-...

# Require authentication for Mastra agent endpoints
MASTRA_REQUIRE_AUTH=true

# --- TLS / HTTPS ---
# Sinopebase serves plain HTTP. Terminate TLS at Railway's edge (default).
# Only set these if you need Sinopebase to terminate TLS itself:
# TLS_CERT=
# TLS_KEY=
