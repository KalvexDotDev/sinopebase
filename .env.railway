# =============================================================================
# Sinopebase — Railway Production Environment Variables
# =============================================================================
# These are the ACTUAL variable KEY=VALUE pairs to set in Railway.
# Copy each line to Railway Dashboard > Service > Variables > Raw Editor.
#
# NEVER commit real values of JWT_SECRET, keys, or passwords here.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Runtime mode ---
# SINOPEBASE_PRODUCTION=true forces fail-closed behavior:
#   - Rejects known default/test JWT secrets
#   - Refuses memory/local fallbacks when POSTGRES_URL is set
#   - Enforces credential validation at boot
SINOPEBASE_PRODUCTION=true

# --- Database ---
# Railway PostgreSQL auto-injects DATABASE_URL as a shared variable.
# Sinopebase reads POSTGRES_URL → set to the Railway shared variable reference.
# In the Railway dashboard, use the reference picker (Cmd+K → "variable")
# to select the DATABASE_URL from your PostgreSQL service.
#
# If using a Railway PostgreSQL plugin, DATABASE_URL is set automatically.
# If using an external database, set POSTGRES_URL directly:
# POSTGRES_URL=postgresql://user:password@host:5432/sinopebase?sslmode=require

# --- Auth / JWT (REQUIRED — generate unique values) ---
# Generate: openssl rand -hex 32
# DO NOT use these placeholder values in production:
#   sinopebase-dev-jwt-secret-min-32-chars!!
#   test-service-role-key
#   test-anon-key
# The server will REFUSE to start in production mode with these defaults.
JWT_SECRET=
SINOPEBASE_SERVICE_ROLE_KEY=
SINOPEBASE_ANON_KEY=

# --- Storage (Railway Bucket — S3-compatible) ---
# Railway Buckets auto-inject credentials. In the Railway dashboard,
# use the variable reference picker to set these:
#   S3_ENDPOINT = ${{storage.BUCKET_NAME.BUCKET_ENDPOINT}}
#   S3_ACCESS_KEY = ${{storage.BUCKET_NAME.ACCESS_KEY_ID}}
#   S3_SECRET_KEY = ${{storage.BUCKET_NAME.SECRET_ACCESS_KEY}}
#   S3_BUCKET = "sinope-evidence-prod"
#   S3_REGION = ${{storage.BUCKET_NAME.BUCKET_REGION}}
#
# For external S3-compatible storage (Cloudflare R2, AWS S3), set these directly:
# S3_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=sinopebase-storage
# S3_REGION=auto

# --- AI / Mastra ---
# Set to enable Mastra agent endpoints
# OPENAI_API_KEY=sk-...
MASTRA_REQUIRE_AUTH=true

# --- Security hardening ---
# Railway terminates TLS at the edge. No application-level TLS needed.
# The service listens on ${{RAILWAY_PRIVATE_DOMAIN}}:${{PORT}} internally.
# All external traffic goes through Railway's TLS-terminating proxy.
