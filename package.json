{
  "name": "sinopebase",
  "version": "0.2.1",
  "module": "cmd/serve.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch cmd/serve.ts",
    "build": "bun build cmd/serve.ts --outdir dist --target bun",
    "compile": "bun build cmd/serve.ts --compile --outfile sinopebase",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:harness": "bun test tests/harness/harness.test.ts",
    "test:taxonomy": "bun tests/harness/audit.ts",
    "test:component": "bun test tests/integration/app-lifecycle.test.ts tests/integration/pb-api-",
    "test:contract:auth": "bun test tests/integration/auth.test.ts tests/integration/auth-better.test.ts",
    "test:contract:postgrest": "bun test tests/integration/postgrest.test.ts",
    "test:contract:storage": "bun test tests/integration/storage.test.ts",
    "test:contract:realtime": "bun test tests/integration/realtime.test.ts",
    "test:contract:postgres-rls": "bun test src/core/db-postgres-contract.test.ts src/core/db-postgres-rls.test.ts",
    "test:integration:plugins": "bun test tests/plugins/",
    "test:compatibility": "bun test src/apis/postgrest.test.ts src/apis/postgrest-head-count.test.ts src/apis/postgrest-in-filter.test.ts src/apis/realtime-postgres-changes.test.ts src/apis/file.test.ts src/core/postgres-role-bootstrap.test.ts src/core/db-postgres-rls.test.ts tests/tools/auth-better/supabase-bridge.test.ts tests/integration/auth-better.test.ts",
    "test:release": "bun tests/harness/require-release-infra.ts && bun run test:component && bun run test:contract:auth && bun run test:contract:postgrest && bun run test:contract:storage && bun run test:contract:realtime && bun run test:contract:postgres-rls && bun run test:integration:plugins && bun test",
    "lint": "biome check src/ tests/",
    "lint:eslint": "bun run scripts/lint-eslint.ts",
    "lint:eslint:sarif": "bun run scripts/lint-eslint.ts --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif",
    "lint:jscpd": "jscpd src/ tests/ --config .jscpd.json",
    "format": "biome format --write src/ tests/",
    "format:check": "biome format src/ tests/",
    "typecheck": "bun run tsc --noEmit",
    "typecheck:ci": "bun run scripts/typecheck-ci.ts",
    "typecheck:harness": "bun run tsc --noEmit --project wave0-test-tsconfig.json",
    "test:ci": "bun test --reporter=junit --reporter-outfile=junit.xml",
    "security:semgrep": "semgrep --config .semgrep.yml --sarif --output semgrep-results.sarif src/ tests/",
    "security:gitleaks": "gitleaks detect --config .gitleaks.toml --verbose",
    "gitleaks:install": "git config core.hooksPath .githooks",
    "lint:yaml": "yaml valid .github/workflows/ci.yml .github/workflows/supply-chain.yml",
    "ci": "bun run ci:audit && bun run lint:yaml && bun run format:check && bun run lint && bun run lint:eslint && bun run lint:jscpd && bun run typecheck && bun run test && bun run build",
    "ci:audit": "bun audit; exit 0"
  },
  "exports": {
    ".": "./cmd/serve.ts",
    "./sdk": "./src/sdk/client.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "jscpd": "^5.0.14",
    "tap-xunit": "^2.4.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "adm-zip": "^0.6.0",
    "better-auth": "^1.6.25",
    "elysia": "^1.4.29",
    "kysely": "^0.29.4",
    "minio": "^8.0.7",
    "pg": "^8.22.0",
    "randexp": "^0.5.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "lodash": ">=4.17.21",
    "brace-expansion": ">=2.0.2"
  }
}
