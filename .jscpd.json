{
  "threshold": 5,
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "ignore": [
    "node_modules/**",
    "dist/**",
    "ui/**",
    ".claude/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "reporters": ["consoleFull", "json"],
  "output": "./jscpd-report.json",
  "absolute": false
}
